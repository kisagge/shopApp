# 로컬 개발용 예시. 실제 값은 .env 에 넣고 절대 커밋하지 않습니다.

# PostgreSQL — tooling/docker-compose.yml 기준
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop?schema=public"

# Better Auth — openssl rand -base64 32 로 생성
BETTER_AUTH_SECRET="여기에-랜덤-시크릿"
BETTER_AUTH_URL="http://localhost:3000"

# 앱 공개 URL. Capacitor 셸이 이 주소를 로드합니다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 토스페이먼츠 테스트 키.
# **비워 두면 Mock 게이트웨이로 돈다.** 형식이 맞지 않는 값(플레이스홀더 포함)도
# Mock 으로 처리한다 — 실제 API 를 모르고 두드리는 사고를 막기 위해서다.
# https://developers.tosspayments.com 에서 발급받아 넣으세요.
# 토스페이먼츠. https://developers.tosspayments.com 에서 직접 발급받는다.
# 개발자센터 > 내 개발정보 에 테스트 키 두 개가 있다.
#   클라이언트 키(test_ck_...)는 브라우저에 나가는 값이라 공개돼도 된다.
#   시크릿 키(test_sk_...)는 절대 클라이언트로 내보내지 않는다.
# 비워 두면 Mock 게이트웨이로 돌아 결제창 없이 주문 흐름을 볼 수 있다.
# 형식이 맞지 않으면(플레이스홀더 등) 개발 환경은 Mock 으로 떨어지고
# 프로덕션은 부팅에 실패한다 — 조용히 Mock 으로 도는 것이 최악이라서다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# 이벤트 로그의 IP 해시 솔트. 원본 IP는 저장하지 않고 이 값과 날짜를 섞어 해시한다.
# openssl rand -base64 32 로 생성. 바꾸면 이전 해시와 대조가 끊긴다.
EVENT_IP_SALT="여기에-랜덤-솔트"

# 이미지 저장소 (S3 호환).
#
# 아래 값은 tooling/docker-compose.yml 의 MinIO 기본값입니다 — 그 파일에
# 이미 적혀 있으므로 비밀이 아닙니다.
#
# **S3_PUBLIC_BASE_URL 은 엔드포인트와 다른 값입니다.** 엔드포인트는 서버가
# 쓰기에 쓰고, 이쪽은 브라우저가 읽기에 씁니다. 읽기는 우리 코드를 거치지
# 않고 이 주소로 곧장 갑니다.
#
# **네 값(BUCKET·ACCESS_KEY_ID·SECRET·PUBLIC_BASE_URL)이 모두 있어야
# 업로드가 켜집니다.** 하나라도 없으면 동작하는 척하지 않고 거절합니다.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="shop-media"
S3_ACCESS_KEY_ID="shop"
S3_SECRET_ACCESS_KEY="shopshop"
S3_PUBLIC_BASE_URL="http://localhost:9000/shop-media"
# MinIO 는 가상 호스트 방식을 기본으로 못 쓴다. AWS S3 면 false.
S3_FORCE_PATH_STYLE="true"
#
# ── Cloudflare R2 로 붙일 때 ─────────────────────────────────
# 이그레스가 무료라 크롤러가 훑어도 요금이 올라가지 않는다. 코드는 그대로다.
#
#   S3_ENDPOINT="https://<계정ID>.r2.cloudflarestorage.com"   # 버킷 이름은 빼고
#   S3_REGION="auto"                                          # R2 는 auto 다
#   S3_BUCKET="<버킷 이름>"
#   S3_PUBLIC_BASE_URL="https://pub-<...>.r2.dev"             # 아래 설정을 켜야 나온다
#   S3_FORCE_PATH_STYLE="true"
#
# 키는 R2 첫 화면의 "Manage R2 API Tokens" → Create **Account** API token.
# 권한은 Object Read & Write 로 좁힌다(Admin 은 버킷 삭제까지 된다).
# 버킷 설정의 **Public Development URL 을 Enable** 해야 공개 주소가 생긴다 —
# 켜지 않으면 업로드는 성공하는데 화면에 이미지가 안 뜬다.

# 섀도 DB — prisma migrate dev/diff 가 마이그레이션을 검사할 때 임시로 쓰는
# **빈** 데이터베이스. 개발 DB 를 가리키면 검사 중에 데이터가 날아갑니다.
# 배포 환경에는 필요 없습니다 (migrate deploy 는 섀도 DB 를 쓰지 않습니다).
SHADOW_DATABASE_URL="postgresql://shop:shop@localhost:5432/shop_shadow?schema=public"

# 마이그레이션 전용 직결 주소 (배포 시).
# DATABASE_URL 은 풀러를 거친 주소여야 하는데, 트랜잭션 모드 풀러는 DDL 과
# 어드바이저리 락을 제대로 다루지 못해 마이그레이션이 멈춥니다.
#
# Neon 의 Vercel 통합을 쓰면 DATABASE_URL_UNPOOLED 라는 이름으로 자동 주입되고,
# 코드가 그 이름도 함께 읽으므로 **따로 넣지 않아도 됩니다.**
# 로컬은 풀러가 없으므로 비워 두면 DATABASE_URL 을 그대로 씁니다.
DIRECT_DATABASE_URL=""

# Vercel Cron 인증. openssl rand -base64 32 로 생성.
# **비워 두면 배치 라우트가 503 으로 거절합니다** — 설정을 빠뜨렸을 때
# 조용히 무방비가 되는 것보다 낫습니다.
CRON_SECRET=""

# ── 메일 발송 ────────────────────────────────────────────────
# 둘 다 있어야 실제로 나간다. 하나라도 없으면 콘솔에 "미발송" 으로만 남는다.
#
# Resend 는 사업자등록증 없이 무료로 쓸 수 있지만, **도메인 인증 전에는
# 계정 주인 주소로만 배달한다.** 아무에게나 보내려면 도메인 하나와
# DNS 인증이 필요하다. 시드 계정은 전부 .test 라 어차피 받지 못한다.
RESEND_API_KEY=
MAIL_FROM="PLAIN <onboarding@resend.dev>"

# ── 구글 소셜 로그인 ──────────────────────────────────────────
# 둘 다 있어야 켜진다. 하나라도 비면 로그인 화면에 구글 버튼이 나오지 않는다 —
# 눌러도 안 되는 버튼을 보여 주는 것보다 없는 편이 낫다.
#
# 구글 클라우드 콘솔 > Clients > 웹 애플리케이션 으로 만든다.
# 승인된 리디렉션 URI 에 아래 둘을 **정확히** 넣어야 한다(끝 슬래시·포트까지):
#   http://localhost:3000/api/auth/callback/google
#   https://<배포 도메인>/api/auth/callback/google
#
# NEXT_PUBLIC_ 을 붙이지 않는다. 서버에서만 읽는 값이고, 시크릿이 브라우저
# 번들에 들어가면 그대로 유출이다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 네이티브 앱용 iOS 클라이언트 ID.
# 비밀이 아니다 — 앱 바이너리에 그대로 박히는 값이고 시크릿도 발급되지 않는다.
# 안드로이드는 별도 ID 가 필요 없다. 콘솔에 패키지명+SHA-1 로 클라이언트만
# 만들어 두면 구글이 서명으로 앱을 알아보고, 코드에서는 웹 클라이언트 ID 를 쓴다.
GOOGLE_IOS_CLIENT_ID=

# ── 오류 알림 ────────────────────────────────────────────────
# 비우면 오류가 로그에만 남는다. 주소를 넣으면 메일로도 알린다.
#
# 같은 오류는 한 시간에 한 번만 보낸다. 오류는 몰려서 나기 때문에 한 건마다
# 보내면 받는 쪽이 곧 알림을 무시하게 되고, 그러면 알림이 없는 것과 같아진다.
# 메일 발송(RESEND_API_KEY)이 함께 설정돼 있어야 실제로 나간다.
ERROR_ALERT_EMAIL=
