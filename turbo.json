{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "TOSS_SECRET_KEY",
    "NEXT_PUBLIC_TOSS_CLIENT_KEY",
    "NEXT_PUBLIC_APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    // dev 도 ^build 를 먼저 돌린다. @shop/db 의 build 가 prisma generate 라,
    // 이게 없으면 스키마를 바꾼 뒤 dev 를 켰을 때 옛 클라이언트로 돈다 —
    // 그러면 prisma.newModel 이 undefined 라서 "Cannot read properties of
    // undefined (reading 'findMany')" 만 보이고 원인이 드러나지 않는다.
    // 실제로 상품 문의를 붙인 뒤 그렇게 겪었다.
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "sync": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
