// PLAIN 커머스 스키마
//
// 두 가지 원칙이 전체를 관통한다.
//
// 1) 금액은 전부 Int, 원 단위다. Decimal도 Float도 쓰지 않는다.
//    packages/core 의 Won 브랜드 타입과 같은 표현이라 경계에서 변환이 필요 없다.
//
// 2) 주문은 그 시점의 사실을 스냅샷으로 박는다. 상품명·브랜드·옵션·가격이
//    나중에 바뀌어도 이미 발생한 주문 내역은 변하지 않아야 한다.
//    주문 테이블에서 Product를 조인해 이름을 가져오면 안 된다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────── 회원

/// 회원 등급. 구매 실적에 따른 혜택 구간이지 권한이 아니다.
enum MemberGrade {
  BASIC
  SILVER
  GOLD
  VIP
}

enum AnalyticsConsent {
  GRANTED
  DENIED
}

/// 권한 계층. packages/core 의 authz 와 값이 정확히 일치해야 한다.
///
/// CUSTOMER    자기 주문·리뷰·장바구니만
/// MERCHANT    자기 가맹점의 상품과, 자기 상품이 포함된 주문만
/// ADMIN       전체 운영. 다만 권한 부여와 가맹점 승인은 못 한다
/// SUPER_ADMIN 전부. 관리자 임명과 가맹점 입점 승인 포함
enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified Boolean     @default(false)
  name          String
  phone         String?
  /// Better Auth 가 요구하는 필드. 프로필 이미지 URL.
  image         String?
  role          UserRole    @default(CUSTOMER)
  grade         MemberGrade @default(BASIC)

  /// 분석 이벤트 수집 동의.
  ///
  /// **null 은 "아직 결정하지 않음"** 이고 DENIED 와 다르다.
  /// null 이면 익명 사용자와 같은 기본값을 따르고, DENIED 는 사용자가 명시적으로
  /// 거부한 것이라 반드시 존중한다. 둘을 합치면 로그인하는 순간 추적이 줄어든다.
  ///
  /// Boolean? 이 아니라 enum 인 이유: Better Auth 가 세션으로 실어 나를 때
  /// nullable boolean 을 false 로 강제 변환해서 "미결정" 과 "거부" 를 구분할 수 없다.
  analyticsConsent AnalyticsConsent?

  /// MERCHANT 역할일 때만 채운다. 이 값이 그 사용자가 볼 수 있는 범위를 정한다.
  /// role 이 MERCHANT 인데 여기가 비어 있으면 아무것도 볼 수 없다 — 의도된 안전 기본값이다.
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  /// 포인트 잔액 캐시. 진실은 PointTransaction 원장이고 이 값은 그 합계다.
  /// 매번 합계를 구하면 마이페이지가 느려져서 캐시하되, 정합성은 배치로 검증한다.
  pointBalance Int @default(0)

  addresses      Address[]
  orders         Order[]
  cartItems      CartItem[]
  reviews        Review[]
  wishlist       WishlistItem[]
  coupons        UserCoupon[]
  pointHistory   PointTransaction[]
  restockAlerts  RestockNotification[]
  events         EventLog[]
  auditLogs      AdminAuditLog[]        @relation("AuditActor")
  sessions       Session[]
  accounts       Account[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([role])
  @@index([merchantId])
  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String? // "집", "회사"
  recipient    String
  phone        String
  postalCode   String
  address1     String
  address2     String?
  /// 제주·도서산간 여부. 배송비 추가 판정에 쓴다.
  isRemoteArea Boolean @default(false)
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─────────────────────────────────────────── 가맹점

/// 입점 심사 상태. 승인 전에는 상품을 공개할 수 없다.
enum MerchantStatus {
  PENDING
  APPROVED
  SUSPENDED
  TERMINATED
}

model Merchant {
  id     String         @id @default(cuid())
  name   String         @unique
  status MerchantStatus @default(PENDING)

  // ── 사업자 정보
  businessName     String
  businessNumber   String  @unique
  representative   String
  contactEmail     String
  contactPhone     String

  // ── 정산
  /// 판매액에서 떼는 수수료율(%). 가맹점마다 다를 수 있다.
  commissionPercent Int    @default(15)
  settlementBank    String?
  settlementAccount String?
  settlementHolder  String?

  users       User[]
  brands      Brand[]
  settlements Settlement[]

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@map("merchants")
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  PAID
  HELD
}

/// 가맹점별 정산. 기간 단위로 묶어 확정하고 지급한다.
model Settlement {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  /// 해당 기간 확정 매출(구매확정 기준)
  grossAmount Int
  /// 떼어 간 수수료
  commissionAmount Int
  /// 환불·반품으로 차감된 금액
  refundAmount Int @default(0)
  /// 실제 지급액 = gross - commission - refund
  netAmount Int

  status SettlementStatus @default(PENDING)

  confirmedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  /// 같은 가맹점의 같은 기간을 두 번 정산하지 않는다.
  @@unique([merchantId, periodStart, periodEnd])
  @@index([status, periodEnd])
  @@map("settlements")
}

// ─────────────────────────────────────────── 상품

model Brand {
  id      String  @id @default(cuid())
  name    String  @unique
  slug    String  @unique
  logoUrl String?

  /// 브랜드를 운영하는 가맹점. 가맹점의 권한 범위는 이 관계를 타고 결정된다.
  /// 자사 직매입 브랜드는 null 이고, 그때는 관리자만 다룰 수 있다.
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  @@index([merchantId])
  @@map("brands")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  /// 자기참조 트리. 아우터 > 코트 같은 2~3단 구조를 담는다.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  sortOrder Int       @default(0)
  products Product[]

  createdAt DateTime @default(now())

  @@index([parentId, sortOrder])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  HIDDEN
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  status      ProductStatus @default(DRAFT)

  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// 정가. 화면에 취소선으로 보여 주는 값.
  listPrice Int
  /// 실제 판매가. null 이면 할인 없이 정가로 판다.
  ///
  /// **할인율이 아니라 판매가를 저장한다.** 할인율을 저장하고 판매가를 계산하면
  /// 413,000 의 30% 는 289,100 이 되는데, 국내 커머스는 289,000 처럼 딱 떨어지는
  /// 값을 판매가로 정하고 할인율은 거기서 계산해 표시한다.
  /// 표시용 할인율은 packages/core 의 discountRateOf 가 만든다.
  salePrice Int?

  /// 목록 정렬·필터에 쓰는 집계값. 리뷰/주문 발생 시 갱신한다.
  ratingSum   Int @default(0)
  reviewCount Int @default(0)
  soldCount   Int @default(0)

  images      ProductImage[]
  optionGroups ProductOptionGroup[]
  variants    ProductVariant[]
  reviews     Review[]
  wishedBy    WishlistItem[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// 비워 두지 말 것. 스크린리더가 읽는 유일한 설명이다.
  alt       String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductOptionGroup {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // "색상", "사이즈"
  sortOrder Int     @default(0)

  values ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_option_groups")
}

model ProductOptionValue {
  id        String             @id @default(cuid())
  groupId   String
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  value     String // "오트밀", "M"
  /// 색상 옵션의 스와치 색. 그 외에는 null.
  swatchHex String?
  sortOrder Int                @default(0)

  variants ProductVariant[]

  @@unique([groupId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique

  optionValues ProductOptionValue[]

  /// 화면·주문 스냅샷에 쓰는 조합 라벨. "오트밀 / M"
  /// 옵션 조합을 매번 조인해 조립하면 목록 쿼리가 무거워진다.
  label String

  /// 옵션별 가격 차이가 있을 때만 채운다. null이면 product.listPrice를 쓴다.
  priceOverride Int?
  stock         Int  @default(0)
  isActive      Boolean @default(true)

  cartItems     CartItem[]
  orderItems    OrderItem[]
  restockAlerts RestockNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive])
  @@map("product_variants")
}

// ─────────────────────────────────────────── 장바구니

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  selected  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 같은 옵션을 두 줄로 담지 않는다. 다시 담으면 수량만 올린다.
  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

// ─────────────────────────────────────────── 주문

/// packages/core 의 ORDER_STATUS 와 값이 정확히 일치해야 한다.
/// 어긋나면 상태 전이 규칙이 DB에 반영되지 않는다 — 테스트로 강제한다.
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CONFIRMED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id      String      @id @default(cuid())
  /// 고객에게 보여 주는 주문번호. "20260831-8842713"
  orderNo String      @unique
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  status  OrderStatus @default(PENDING)

  // ── 금액 스냅샷. 계산은 packages/core 가 하고 결과만 박는다.
  listTotal        Int
  productDiscount  Int
  couponDiscount   Int @default(0)
  pointsUsed       Int @default(0)
  shippingFee      Int @default(0)
  /// 실제 결제 금액. 위 값들의 계산 결과이지만 별도로 저장한다 —
  /// 정책이 바뀌어도 과거 주문의 결제액은 그대로여야 한다.
  payable          Int
  rewardPoints     Int @default(0)

  // ── 배송지 스냅샷. Address를 참조만 하면 고객이 주소를 고칠 때
  //    과거 주문의 배송지까지 바뀐다.
  recipient      String
  recipientPhone String
  postalCode     String
  address1       String
  address2       String?
  isRemoteArea   Boolean @default(false)
  deliveryMemo   String?

  /// 주문을 만든 브라우저 세션. 퍼널을 이어 붙이는 데 쓴다.
  ///
  /// 이게 없으면 purchase 이벤트가 조회·담기와 다른 세션으로 기록돼
  /// 전환율이 영원히 0% 로 나온다 — 실제로 그렇게 만들었다가 고쳤다.
  /// 분석용이라 없어도 주문은 성립한다.
  browserSessionId String?

  usedCouponId String?
  usedCoupon   UserCoupon? @relation(fields: [usedCouponId], references: [id])

  items      OrderItem[]
  payment    Payment?
  shipment   Shipment?
  statusLogs OrderStatusLog[]
  pointTxns  PointTransaction[]

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  confirmedAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 재고 복원·재구매에 쓴다. 상품이 삭제돼도 주문 내역은 남아야 하므로
  /// onDelete를 걸지 않고 참조만 유지한다.
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // ── 주문 시점 스냅샷
  /// 어느 가맹점의 상품이었는지. 정산과 가맹점 주문 조회의 기준이 된다.
  /// 한 주문에 여러 가맹점 상품이 섞일 수 있어 Order가 아니라 줄 단위로 둔다.
  merchantId   String?
  productName  String
  brandName    String
  optionLabel  String
  imageUrl     String?
  /// 주문 시점의 정가
  listPrice    Int
  /// 주문 시점의 실제 판매 단가. 표시 할인율은 이 둘에서 계산되므로 따로 두지 않는다.
  unitPrice    Int
  quantity     Int
  /// unitPrice * quantity
  subtotal     Int

  /// 부분 취소·부분 반품을 지원하려면 줄 단위 상태가 필요하다.
  status OrderStatus @default(PENDING)

  review Review?

  @@index([orderId])
  @@index([variantId])
  @@index([merchantId, status])
  @@map("order_items")
}

model OrderStatusLog {
  id      String       @id @default(cuid())
  orderId String
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from    OrderStatus?
  to      OrderStatus
  /// 누가 바꿨는지. 어드민 계정 id이거나 "system"(웹훅·배치).
  actor   String
  note    String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

// ─────────────────────────────────────────── 결제

enum PaymentMethod {
  CARD
  TRANSFER
  VIRTUAL_ACCOUNT
  EASY_PAY
}

/// 토스페이먼츠 결제 상태를 그대로 따른다. PG 상태를 우리 말로 번역하면
/// 웹훅을 대조할 때 매번 매핑 표를 봐야 한다.
enum PaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
  FAILED
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(READY)
  amount Int

  /// PG가 발급한 키. 취소·조회에 쓴다.
  pgProvider      String  @default("toss")
  pgPaymentKey    String? @unique
  pgApprovalNo    String?
  /// 가상계좌 정보
  virtualAccount  String?
  virtualBank     String?
  virtualDueDate  DateTime?

  /// 환불 누계. 부분 취소가 여러 번 일어날 수 있다.
  refundedAmount Int @default(0)

  /// PG 응답 원문. 대사(reconciliation)와 장애 분석에 필요하다.
  rawResponse Json?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  canceledAt  DateTime?

  @@index([status, requestedAt])
  @@map("payments")
}

// ─────────────────────────────────────────── 배송

model Shipment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier        String? // "CJ대한통운"
  trackingNumber String?

  shippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingNumber])
  @@map("shipments")
}

// ─────────────────────────────────────────── 쿠폰 · 포인트

enum CouponKind {
  AMOUNT
  PERCENT
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  name String
  kind CouponKind

  /// AMOUNT면 할인액, PERCENT면 사용하지 않는다.
  value Int @default(0)
  /// PERCENT일 때 할인율. AMOUNT면 0.
  percent Int @default(0)
  /// PERCENT 쿠폰의 할인 상한. null이면 상한 없음.
  maxDiscount Int?
  minimumOrder Int @default(0)

  /// 발급 총량. null이면 무제한.
  issueLimit  Int?
  issuedCount Int  @default(0)

  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  issued UserCoupon[]

  createdAt DateTime @default(now())

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model UserCoupon {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  usedAt    DateTime?
  expiresAt DateTime
  orders    Order[]

  issuedAt DateTime @default(now())

  /// 같은 쿠폰을 한 사람이 두 번 받지 않는다.
  @@unique([userId, couponId])
  @@index([userId, usedAt])
  @@map("user_coupons")
}

/// 포인트는 잔액만 두면 왜 그렇게 됐는지 설명할 수 없다.
/// 증감을 원장으로 남기고 User.pointBalance 는 그 합계 캐시로 둔다.
enum PointReason {
  EARN_PURCHASE
  USE_PURCHASE
  EARN_REVIEW
  EARN_SIGNUP
  CANCEL_REFUND
  EXPIRE
  ADMIN_ADJUST
}

model PointTransaction {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 적립은 양수, 사용은 음수. 부호로 방향을 표현해 합계가 곧 잔액이 된다.
  amount Int
  reason PointReason
  note   String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// 적립 포인트의 소멸 예정일. 사용/소멸 건은 null.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("point_transactions")
}

// ─────────────────────────────────────────── 리뷰 · 찜 · 재입고

model Review {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 구매한 사람만 쓸 수 있다. 주문 항목 하나당 리뷰 하나.
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  rating  Int // 1~5
  content String
  /// "정사이즈" / "큼" / "작음" — 상세 화면의 사이즈 분포에 쓴다.
  sizeFit String?
  /// 리뷰어 체형. 사이즈 판단에 실제로 도움이 되는 정보다.
  height  Int?
  weight  Int?

  imageUrls String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId, createdAt])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model RestockNotification {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, variantId])
  @@index([variantId, notifiedAt])
  @@map("restock_notifications")
}

// ─────────────────────────────────────────── 이벤트 · 감사

/// 사용자 행동 이벤트.
///
/// 자주 집계하는 축만 컬럼으로 뽑고 나머지는 props(Json)에 둔다.
/// 전부 Json 에 넣으면 집계 쿼리를 못 쓰고, 전부 컬럼으로 빼면 이벤트를
/// 하나 추가할 때마다 마이그레이션이 필요해진다.
model EventLog {
  id   String @id @default(cuid())
  /// packages/core 의 COMMERCE_EVENT 값. enum 으로 두지 않는 이유는
  /// 이벤트를 하나 추가할 때마다 DB 마이그레이션을 돌리고 싶지 않아서다.
  /// 유효성은 수집 API 의 Zod 스키마가 이미 보장한다.
  name String

  /// 브라우저가 찍은 시각. 기기 시계는 틀리거나 조작되므로 순서 복원에만 쓴다.
  occurredAt DateTime
  /// 서버 도착 시각. **집계는 이 값을 기준으로 한다.**
  receivedAt DateTime @default(now())

  sessionId   String
  anonymousId String
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  path     String
  referrer String?

  // ── 집계 축. 이벤트 종류에 따라 채워지는 것이 다르다.
  productId  String?
  variantId  String?
  orderId    String?
  merchantId String?
  /// 금액(원). 서버가 기록하는 purchase·refund 에서만 채워진다.
  value      Int?
  quantity   Int?

  /// mobile | tablet | desktop. 원본 User-Agent 는 저장하지 않는다.
  deviceType String?
  /// 일별 솔트로 해시한 IP. 원본은 저장하지 않고 봇 판별에만 쓴다.
  ipHash     String?

  /// 위 컬럼으로 뽑지 않은 나머지 속성
  props Json @default("{}")

  @@index([name, receivedAt])
  @@index([sessionId, occurredAt])
  @@index([userId, receivedAt])
  @@index([productId, name])
  @@index([receivedAt])
  @@map("event_logs")
}

/// 운영진·가맹점의 쓰기 동작 기록.
///
/// 권한을 나눠 놓고 누가 무엇을 했는지 남기지 않으면 절반만 한 것이다.
/// 환불·권한부여처럼 되돌릴 수 없고 돈이 걸린 동작이 대상이다.
model AdminAuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  /// **그 시점의** 역할과 소속. 나중에 역할이 바뀌어도 "그때 무슨 권한으로
  /// 했는지"가 남아야 하므로 조인이 아니라 스냅샷으로 박는다.
  actorRole  UserRole
  merchantId String?

  /// 'order.refund', 'user.assignRole' 처럼 <대상>.<동작> 형태
  action     String
  targetType String
  targetId   String

  /// 변경 전후. 민감 필드는 호출부에서 제외하고 넘긴다.
  before Json?
  after  Json?

  ipHash String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────── 인증 (Better Auth)
//
// 아래 세 모델의 필드 이름과 타입은 Better Auth 가 요구하는 그대로다.
// 임의로 바꾸면 어댑터가 찾지 못한다. User 는 우리 모델을 그대로 쓰되
// Better Auth 가 요구하는 image 만 추가했다.

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  /// 세션 탈취 탐지에 쓴다. 이벤트 로그와 달리 여기서는 원본을 보관한다 —
  /// 수상한 로그인을 사용자에게 보여 주려면 실제 값이 필요하다.
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id         String @id @default(cuid())
  issuer     String
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 소셜 로그인 토큰. 이메일 가입이면 password 만 채워진다.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Better Auth 가 해시해서 넣는다. 평문이 들어올 일은 없다.
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}
