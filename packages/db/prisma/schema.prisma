// PLAIN 커머스 스키마
//
// 두 가지 원칙이 전체를 관통한다.
//
// 1) 금액은 전부 Int, 원 단위다. Decimal도 Float도 쓰지 않는다.
//    packages/core 의 Won 브랜드 타입과 같은 표현이라 경계에서 변환이 필요 없다.
//
// 2) 주문은 그 시점의 사실을 스냅샷으로 박는다. 상품명·브랜드·옵션·가격이
//    나중에 바뀌어도 이미 발생한 주문 내역은 변하지 않아야 한다.
//    주문 테이블에서 Product를 조인해 이름을 가져오면 안 된다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────── 회원

/// 회원 등급. 구매 실적에 따른 혜택 구간이지 권한이 아니다.
enum MemberGrade {
  BASIC
  SILVER
  GOLD
  VIP
}

enum AnalyticsConsent {
  GRANTED
  DENIED
}

/// 권한 계층. packages/core 의 authz 와 값이 정확히 일치해야 한다.
///
/// CUSTOMER    자기 주문·리뷰·장바구니만
/// MERCHANT    자기 가맹점의 상품과, 자기 상품이 포함된 주문만
/// ADMIN       전체 운영. 다만 권한 부여와 가맹점 승인은 못 한다
/// SUPER_ADMIN 전부. 관리자 임명과 가맹점 입점 승인 포함
enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified Boolean     @default(false)
  name          String
  phone         String?
  /// Better Auth 가 요구하는 필드. 프로필 이미지 URL.
  image         String?
  role          UserRole    @default(CUSTOMER)
  grade         MemberGrade @default(BASIC)

  /// 분석 이벤트 수집 동의.
  ///
  /// **null 은 "아직 결정하지 않음"** 이고 DENIED 와 다르다.
  /// null 이면 익명 사용자와 같은 기본값을 따르고, DENIED 는 사용자가 명시적으로
  /// 거부한 것이라 반드시 존중한다. 둘을 합치면 로그인하는 순간 추적이 줄어든다.
  ///
  /// Boolean? 이 아니라 enum 인 이유: Better Auth 가 세션으로 실어 나를 때
  /// nullable boolean 을 false 로 강제 변환해서 "미결정" 과 "거부" 를 구분할 수 없다.
  analyticsConsent AnalyticsConsent?

  /// 이 사람에게 메일을 보낼 때 쓸 말.
  ///
  /// **null 은 "고른 적 없음"** 이다 — analyticsConsent 와 같은 결이다.
  /// 값이 있다는 것은 사용자가 그 말을 **의도해서** 골랐다는 뜻이고,
  /// 그래서 평범한 요청마다 덮어쓰지 않는다. 기기마다 브라우저 언어가
  /// 다르면 마지막으로 접속한 기기가 이기게 되는데, 그건 고른 것이 아니다.
  ///
  /// 주문 안내는 이 값을 보지 않는다. 주문이 자기 말을 따로 들고 있다 —
  /// 주문서에서 본 금액·상품명과 같은 말로 와야 대조할 수 있기 때문이다.
  locale String?

  /// MERCHANT 역할일 때만 채운다. 이 값이 그 사용자가 볼 수 있는 범위를 정한다.
  /// role 이 MERCHANT 인데 여기가 비어 있으면 아무것도 볼 수 없다 — 의도된 안전 기본값이다.
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  /// 포인트 잔액 캐시. 진실은 PointTransaction 원장이고 이 값은 그 합계다.
  /// 매번 합계를 구하면 마이페이지가 느려져서 캐시하되, 정합성은 배치로 검증한다.
  pointBalance Int @default(0)

  addresses            Address[]
  orders               Order[]
  cartItems            CartItem[]
  reviews              Review[]
  merchantApplications Merchant[]            @relation("MerchantApplicant")
  inquiries            Inquiry[]             @relation("InquiryAuthor")
  inquiryAnswers       Inquiry[]             @relation("InquiryAnswerer")
  supportPosts         SupportPost[]         @relation("SupportPostAuthor")
  reviewReports        ReviewReport[]        @relation("reporter")
  reviewsJudged        ReviewReport[]        @relation("judge")
  wishlist             WishlistItem[]
  coupons              UserCoupon[]
  pointHistory         PointTransaction[]
  restockAlerts        RestockNotification[]
  events               EventLog[]
  auditLogs            AdminAuditLog[]       @relation("AuditActor")
  orderNotes           OrderNote[]
  sessions             Session[]
  accounts             Account[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// 이용 정지. 운영진이 사유와 함께 건다. 정지 중에는 로그인·주문이 막히고, 해제하면 그대로 돌아온다.
  ///
  /// **탈퇴(deletedAt)와 다르다.** 탈퇴는 사람이 떠나며 개인정보를 지우는 되돌릴 수 없는 일이고, 정지는
  /// 운영이 잠시 막는 되돌릴 수 있는 일이다. 주문·포인트·후기는 그대로 둔다 — 해제하면 이어서 쓴다.
  suspendedAt     DateTime?
  suspendedReason String?
  /// 정지를 건 운영자
  suspendedBy     String?

  reviewHelpfuls ReviewHelpful[]
  notifications  Notification[]

  @@index([createdAt])
  @@index([role])
  @@index([merchantId])
  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String? // "집", "회사"
  recipient    String
  phone        String
  postalCode   String
  address1     String
  address2     String?
  /// 제주·도서산간 여부. 배송비 추가 판정에 쓴다.
  isRemoteArea Boolean @default(false)
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─────────────────────────────────────────── 가맹점

/// 입점 심사 상태. 승인 전에는 상품을 공개할 수 없다.
enum MerchantStatus {
  PENDING
  APPROVED
  SUSPENDED
  TERMINATED
}

model Merchant {
  id     String         @id @default(cuid())
  name   String         @unique
  status MerchantStatus @default(PENDING)

  // ── 사업자 정보
  businessName   String
  businessNumber String @unique
  representative String
  contactEmail   String
  contactPhone   String

  // ── 정산
  /// 판매액에서 떼는 수수료율(%). 가맹점마다 다를 수 있다.
  commissionPercent Int     @default(15)
  settlementBank    String?
  settlementAccount String?
  settlementHolder  String?

  /// 입점을 신청한 사람.
  ///
  /// 승인하면 이 계정이 가맹점 계정이 된다. 승인 전에는 users 에 넣지
  /// 않는다 — 넣는 순간 아직 심사 중인 사람에게 범위가 생긴다.
  applicantId String?
  applicant   User?   @relation("MerchantApplicant", fields: [applicantId], references: [id], onDelete: SetNull)
  /// 신청서에 적은 브랜드 이름. 승인할 때 이 이름으로 브랜드를 만든다.
  brandName   String?

  users       User[]
  brands      Brand[]
  settlements Settlement[]
  orderNotes  OrderNote[]

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@map("merchants")
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  PAID
  HELD
}

/// 가맹점별 정산. 기간 단위로 묶어 확정하고 지급한다.
model Settlement {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  /// 해당 기간 확정 매출(구매확정 기준)
  grossAmount      Int
  /// 떼어 간 수수료
  commissionAmount Int
  /// 환불·반품으로 차감된 금액
  refundAmount     Int @default(0)
  /// 실제 지급액 = gross - commission - refund
  netAmount        Int

  status SettlementStatus @default(PENDING)

  confirmedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  /// 같은 가맹점의 같은 기간을 두 번 정산하지 않는다.
  @@unique([merchantId, periodStart, periodEnd])
  @@index([status, periodEnd])
  @@map("settlements")
}

/// 홈 히어로 배너. 운영자가 어드민에서 직접 넣고 뺀다.
///
/// 문구를 코드에 박아 두면 한 줄 바꾸는 데 배포가 필요하다. 기획전은
/// 시작·종료 시각이 정해져 있는 일이라 게시 기간도 함께 둔다.
/// 배송비 정책. **줄이 하나뿐인 표다.**
///
/// 예전에는 `packages/core` 의 상수였다. 계산 규칙은 코드에 있는 것이 맞지만
/// **값은 운영이 정한다** — 무료배송 기준을 5만원에서 3만원으로 내리는 것은
/// 배포할 일이 아니라 그날 결정할 일이다.
///
/// 줄을 하나로 묶는 방법은 고정 id 다. 표를 따로 두지 않고 설정 전체를 담는
/// key-value 표를 쓰는 방법도 있지만, 그러면 값마다 타입이 사라져서 "숫자여야
/// 하는 칸에 글자가 들어간" 상태를 스키마가 못 막는다.
///
/// 줄이 없으면 코드의 기본값을 쓴다. 마이그레이션과 시드 사이에도 가게는
/// 돌아가야 한다.
model ShippingPolicy {
  /// 언제나 "default". 줄이 둘 생기지 않게 못을 박는 자리다.
  id String @id @default("default")

  /// 기본 배송비
  baseFee         Int
  /// 이 금액 이상이면 무료배송. null 이면 무료배송 없음
  freeThreshold   Int?
  /// 제주·도서산간 추가 배송비
  remoteSurcharge Int

  updatedAt   DateTime @updatedAt
  /// 마지막으로 고친 사람. 감사 로그가 진실이고 이건 화면에 보여 줄 값이다.
  updatedById String?

  @@map("shipping_policy")
}

model Banner {
  id String @id @default(cuid())

  /// "EDITORIAL · 01" 같은 윗줄. 없어도 된다.
  eyebrow  String?
  headline String
  subcopy  String?

  /// 버튼 문구와 링크. 둘 다 있어야 버튼을 그린다.
  ctaLabel String?
  href     String?

  imageUrl   String?
  imageAlt   String?
  storageKey String?

  /// 사진이 도착하기 전 그 자리에 깔 아주 작은 같은 사진(webp 데이터 URI).
  /// 이미지마다 HTML 에 실려 나가므로 크기가 곧 비용이다 — 상한은 core 가 정하고,
  /// 넘으면 만들지 않는다(그때는 지금처럼 톤 블록이 깔린다).
  blurDataUrl String?

  /// 사진 출처. 남의 사진을 쓸 때 표기가 없으면 나중에 어느 것이 우리
  /// 것이고 어느 것이 남의 것인지 구분할 방법이 사라진다.
  imageCredit String?

  /// 이미지가 없을 때 쓰는 배경 톤. theme.css 의 --color-ph-* 이름.
  tone String @default("sand")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// 게시 기간. null 이면 제한 없음.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

/// 기획전. 사람이 골라 담은 상품 묶음.
model Collection {
  id String @id @default(cuid())

  /// 주소에 그대로 들어간다.
  slug     String           @unique
  /// 이 기획전이 쓰던 옛 주소들.
  oldSlugs CollectionSlug[]
  title    String
  subtitle String?

  /// 기획전 화면 위쪽에 붙는 긴 설명. 없어도 된다.
  description String?

  imageUrl   String?
  imageAlt   String?
  storageKey String?

  /// 사진이 도착하기 전 그 자리에 깔 아주 작은 같은 사진(webp 데이터 URI).
  /// 이미지마다 HTML 에 실려 나가므로 크기가 곧 비용이다 — 상한은 core 가 정하고,
  /// 넘으면 만들지 않는다(그때는 지금처럼 톤 블록이 깔린다).
  blurDataUrl String?

  /// 사진 출처. 배너와 같은 이유로 둔다.
  imageCredit String?

  /// 이미지가 없을 때 쓰는 배경 톤. 배너와 같은 이름을 쓴다.
  tone String @default("sand")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// 게시 기간. null 이면 제한 없음.
  startsAt DateTime?
  endsAt   DateTime?

  items CollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("collections")
}

/// 기획전에 담긴 상품. 순서 자체가 편집이라 sortOrder 를 둔다.
model CollectionItem {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([collectionId, productId])
  @@index([collectionId, sortOrder])
  @@index([productId])
  @@map("collection_items")
}

// ─────────────────────────────────────────── 상품

model Brand {
  id      String  @id @default(cuid())
  name    String  @unique
  slug    String  @unique
  logoUrl String?

  /// 브랜드를 운영하는 가맹점. 가맹점의 권한 범위는 이 관계를 타고 결정된다.
  /// 자사 직매입 브랜드는 null 이고, 그때는 관리자만 다룰 수 있다.
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  @@index([merchantId])
  @@map("brands")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  /// 자기참조 트리. 아우터 > 코트 같은 2~3단 구조를 담는다.
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  products  Product[]

  createdAt DateTime @default(now())

  @@index([parentId, sortOrder])
  @@map("categories")
}

/// 상품을 보관한 쪽. 사람이 아니라 쪽을 적는다 — 역할은 나중에 바뀌고, 누가 했는지는 감사 로그가 갖는다.
enum ProductArchiver {
  MERCHANT
  STAFF
}

enum ProductStatus {
  DRAFT
  /// 가맹점이 게시를 요청한 상태. 운영진이 보고 올린다.
  PENDING_REVIEW
  ACTIVE
  SOLD_OUT
  HIDDEN
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  /// 이 상품이 쓰던 옛 주소들. 링크가 죽지 않게 넘겨 준다.
  oldSlugs    ProductSlug[]
  name        String
  description String        @default("")
  status      ProductStatus @default(DRAFT)

  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// 정가. 화면에 취소선으로 보여 주는 값.
  listPrice Int
  /// 실제 판매가. null 이면 할인 없이 정가로 판다.
  ///
  /// **할인율이 아니라 판매가를 저장한다.** 할인율을 저장하고 판매가를 계산하면
  /// 413,000 의 30% 는 289,100 이 되는데, 국내 커머스는 289,000 처럼 딱 떨어지는
  /// 값을 판매가로 정하고 할인율은 거기서 계산해 표시한다.
  /// 표시용 할인율은 packages/core 의 discountRateOf 가 만든다.
  salePrice Int?

  /// 실제로 파는 가격 = salePrice ?? listPrice.
  ///
  /// 파생값을 굳이 저장하는 이유는 **정렬과 범위 필터 때문**이다. Prisma 는
  /// COALESCE 같은 식으로 정렬할 수 없고, 가져와서 JS 로 정렬하면 페이지네이션이
  /// 깨진다. 인덱스도 걸 수 없다.
  ///
  /// 파생 규칙은 packages/core 의 sellingPriceOf 가 갖고 있다 — 어드민 쓰기
  /// 경로와 시드가 같은 것을 본다.
  ///
  /// **기본값을 두지 않는다.** @default(0) 이던 시절, 시드가 이 칸을 안 써서
  /// 서른넷 중 스물여섯이 0 으로 남았고 `가격 10만원 이상` 에서 통째로
  /// 사라졌다. 파는 가격이 0 이니 걸릴 리가 없다. 기본값이 없으면 create 에서
  /// 이 칸을 빠뜨리는 것이 **타입 오류**가 되어, 다음 사람은 같은 실수를
  /// 할 수 없다.
  sellingPrice Int

  /// 검색 대상 문자열 = 상품명 + 브랜드명 (소문자).
  ///
  /// 브랜드명을 여기 복사해 두는 이유는 **인덱스를 쓰기 위해서**다.
  /// `p.name ILIKE ... OR b.name ILIKE ...` 처럼 OR 가 두 테이블에 걸치면
  /// Postgres 는 어느 쪽 인덱스도 못 쓰고 전체를 훑는다. 5만 행 기준으로
  /// 재 보니 1002 → 473 buffers 차이였다.
  ///
  /// 쓰기는 manage-product.ts 의 searchTextFor() 한 곳으로 모았다.
  /// 브랜드명을 바꾸는 화면이 생기면 그 브랜드의 상품을 함께 갱신해야 한다.
  searchText String @default("")

  /// 목록 정렬·필터에 쓰는 집계값. 리뷰/주문 발생 시 갱신한다.
  ratingSum   Int @default(0)
  reviewCount Int @default(0)

  /// 평점순 정렬용. 평균 × 100 을 정수로 눌러 둔다 (4.35 → 435).
  ///
  /// 평균은 ratingSum / reviewCount 파생값이라 Prisma 가 정렬할 수 없다.
  /// 실수로 두면 같은 평점끼리의 순서가 미세한 오차로 흔들려 커서가 깨진다.
  /// 리뷰가 없으면 0 이라 평점순에서 자연히 뒤로 밀린다.
  ///
  /// 세 값 모두 write-review.ts 에서 원본을 다시 세어 함께 갱신한다.
  ratingScore Int @default(0)
  soldCount   Int @default(0)

  images       ProductImage[]
  optionGroups ProductOptionGroup[]
  variants     ProductVariant[]
  reviews      Review[]
  wishedBy     WishlistItem[]
  collections  CollectionItem[]

  /// 최초 게시 시각. 이 값이 있으면 검수를 이미 통과한 상품이다 —
  /// 그 뒤로는 가맹점이 직접 내리고 올릴 수 있다.
  publishedAt       DateTime?
  /// 검수를 요청한 시각. 대기줄을 오래된 순으로 꺼내는 데 쓴다.
  reviewRequestedAt DateTime?
  /// 반려 사유. 이유 없이 되돌리면 가맹점은 무엇을 고쳐야 할지 모른다.
  publishRejection  String?

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  /// 보관한 때. **지우지 않고 보관한다** — 주문 줄이 옵션을 가리키고 있어 행을 지울 수 없고, 지울 수 있더라도
  /// 지난 주문·정산·리뷰가 가리킬 것을 잃는다. 매대·검색·장바구니는 이 칸이 비어 있는 상품만 본다.
  deletedAt  DateTime?
  /// 누가 보관했는가. 운영진이 내린 상품을 가맹점이 되살리지 못하게 한다(core product-archive).
  archivedBy ProductArchiver?
  inquiries  Inquiry[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([sellingPrice])
  @@index([ratingScore(sort: Desc)])
  @@index([soldCount(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  /// 부분 일치(ILIKE '%...%') 는 b-tree 로 못 찾는다. 트라이그램 색인이라야 한다.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

/**
 * 상품이 쓰던 옛 주소.
 * slug 는 운영자가 고칠 수 있다. 고치는 순간 그때까지 나간 링크가 전부
 * 죽는데, 화면에는 멀쩡한 404 가 나와서 **아무도 사고인 줄 모른다.**
 * 옛 주소를 남겨 두고 새 주소로 넘긴다.
 * slug 자체가 기본키다 — 한 주소가 두 상품을 가리킬 수는 없다.
 * 상품이 지워지면 옛 주소도 함께 지운다: 넘길 곳이 없어진 기록은
 * 404 를 두 번 거치게 만들 뿐이다.
 */
model ProductSlug {
  slug      String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_slugs")
}

/// 기획전이 쓰던 옛 주소. ProductSlug 와 같은 이유로 둔다.
model CollectionSlug {
  slug         String     @id
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([collectionId])
  @@map("collection_slugs")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// 비워 두지 말 것. 스크린리더가 읽는 유일한 설명이다.
  alt       String
  sortOrder Int     @default(0)

  /// 사진이 도착하기 전 그 자리에 깔 아주 작은 같은 사진(webp 데이터 URI).
  /// 이미지마다 HTML 에 실려 나가므로 크기가 곧 비용이다 — 상한은 core 가 정하고,
  /// 넘으면 만들지 않는다(그때는 지금처럼 톤 블록이 깔린다).
  blurDataUrl String?

  /// 오브젝트 스토리지의 키. 우리가 올린 이미지에만 있다.
  /// url 에서 잘라 쓰지 않는 이유는 공개 도메인(CDN)이 바뀌면
  /// 예전 행의 키를 더 이상 복원할 수 없기 때문이다.
  storageKey String?

  /// 사진의 출처. 우리가 찍지 않은 사진에만 있다.
  ///
  /// **없으면 나중에 설명할 수 없다.** 저장소에 파일만 쌓아 두면 어느 것이
  /// 우리 것이고 어느 것이 남의 것인지 구분할 방법이 사라진다. 표기가
  /// 라이선스상 강제는 아니더라도(Unsplash), 기록은 남겨야 한다.
  credit    String?
  /// 작가 프로필 주소. 화면의 출처 표기를 링크로 만든다.
  creditUrl String?

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductOptionGroup {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // "색상", "사이즈"
  sortOrder Int     @default(0)

  values ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_option_groups")
}

model ProductOptionValue {
  id        String             @id @default(cuid())
  groupId   String
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  value     String // "오트밀", "M"
  /// 색상 옵션의 스와치 색. 그 외에는 null.
  swatchHex String?
  sortOrder Int                @default(0)

  variants ProductVariant[]

  @@unique([groupId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique

  optionValues ProductOptionValue[]

  /// 화면·주문 스냅샷에 쓰는 조합 라벨. "오트밀 / M"
  /// 옵션 조합을 매번 조인해 조립하면 목록 쿼리가 무거워진다.
  label String

  /// 옵션별 가격 차이가 있을 때만 채운다. null이면 product.listPrice를 쓴다.
  priceOverride Int?
  stock         Int     @default(0)
  isActive      Boolean @default(true)

  cartItems     CartItem[]
  orderItems    OrderItem[]
  restockAlerts RestockNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive])
  @@map("product_variants")
}

// ─────────────────────────────────────────── 장바구니

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  selected  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 같은 옵션을 두 줄로 담지 않는다. 다시 담으면 수량만 올린다.
  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

// ─────────────────────────────────────────── 주문

/// packages/core 의 ORDER_STATUS 와 값이 정확히 일치해야 한다.
/// 어긋나면 상태 전이 규칙이 DB에 반영되지 않는다 — 테스트로 강제한다.
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CONFIRMED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id      String      @id @default(cuid())
  /// 고객에게 보여 주는 주문번호. "20260831-8842713"
  orderNo String      @unique
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  status  OrderStatus @default(PENDING)

  // ── 금액 스냅샷. 계산은 packages/core 가 하고 결과만 박는다.
  listTotal       Int
  productDiscount Int
  couponDiscount  Int @default(0)
  pointsUsed      Int @default(0)
  shippingFee     Int @default(0)
  /// 실제 결제 금액. 위 값들의 계산 결과이지만 별도로 저장한다 —
  /// 정책이 바뀌어도 과거 주문의 결제액은 그대로여야 한다.
  payable         Int
  rewardPoints    Int @default(0)

  // ── 배송지 스냅샷. Address를 참조만 하면 고객이 주소를 고칠 때
  //    과거 주문의 배송지까지 바뀐다.
  recipient      String
  recipientPhone String
  postalCode     String
  address1       String
  address2       String?
  isRemoteArea   Boolean @default(false)
  deliveryMemo   String?

  /// 주문을 만든 브라우저 세션. 퍼널을 이어 붙이는 데 쓴다.
  ///
  /// 이게 없으면 purchase 이벤트가 조회·담기와 다른 세션으로 기록돼
  /// 전환율이 영원히 0% 로 나온다 — 실제로 그렇게 만들었다가 고쳤다.
  /// 분석용이라 없어도 주문은 성립한다.
  browserSessionId String?

  /// 주문한 그때의 언어.
  ///
  /// 안내 메일이 이 값을 쓴다. 사용자에게 언어 설정을 따로 두지 않았고,
  /// 두더라도 **주문서를 본 말로 안내가 오는 편이 맞다** — 그때 화면에서
  /// 본 금액·상품명과 같은 말이어야 대조할 수 있다.
  ///
  /// 주문에 남기는 또 다른 이유는 가상계좌다. 입금 확인은 며칠 뒤 웹훅으로
  /// 오는데 그 자리에는 요청도 세션도 없다. 주문이 들고 있지 않으면
  /// 그때 무슨 말로 보낼지 알 방법이 없다.
  locale String?

  /// 같은 주문을 두 번 만들지 않기 위한 열쇠.
  ///
  /// 화면이 결제 시도마다 하나를 만들어 보낸다. 버튼을 두 번 눌렀거나 응답을
  /// 못 받아 다시 보냈을 때, **두 번째 요청은 새 주문을 만들지 않고 먼저
  /// 만들어진 주문을 그대로 돌려받는다.** 없으면 재고가 두 번 깎이고
  /// 결제되지 않은 주문이 하나 더 남는다.
  ///
  /// 옛 주문에는 없으므로 nullable 이다. unique 는 null 을 여럿 허용한다.
  idempotencyKey String? @unique

  usedCouponId String?
  usedCoupon   UserCoupon? @relation(fields: [usedCouponId], references: [id])

  /// 주문한 그때의 배송비 정책(baseFee·freeThreshold·remoteSurcharge).
  ///
  /// 부분 취소로 남은 상품이 무료배송 기준 아래로 떨어지면 배송비를 뗀다. 그 기준은
  /// **주문한 날의 것**이어야 한다 — 운영이 오늘 기준을 3만원에서 5만원으로 올렸다고
  /// 지난주 주문의 취소에서 배송비를 더 떼면 안 된다. 옛 주문은 null 이고 지금 정책을 쓴다.
  shippingPolicy Json?

  items          OrderItem[]
  refunds        OrderRefund[]
  payment        Payment?
  shipment       Shipment?
  statusLogs     OrderStatusLog[]
  returnRequests ReturnRequest[]
  notes          OrderNote[]
  pointTxns      PointTransaction[]

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  confirmedAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, placedAt])
  @@index([status, placedAt])
  /// 아래 넷은 **돈을 세는 질의의 축**이다.
  ///
  /// 매출은 주문한 시각이 아니라 **돈이 오간 시각**에 잡는다(core 의 revenue.ts).
  /// 그렇게 바꾸면서 질의는 `paidAt`·`canceledAt`·`confirmedAt` 으로 옮겼는데
  /// 인덱스는 `placedAt` 축에 그대로 두었다. 30만 행으로 재 보니 대시보드 매출과
  /// 정산 매출이 **테이블을 통째로 훑고**(6,858 buffers) 있었다.
  ///
  /// 넣은 뒤: 총매출 6,858 → 264, 환불 3,553 → 271, 정산 매출 6,858 → 1,106,
  /// 구매확정 배치 4,222 → 20 buffers. 마지막 것이 가장 큰데, 인덱스가 정렬까지
  /// 주어서 top-N 정렬이 통째로 사라진다.
  ///
  /// **쓰기가 그만큼 비싸진다.** 주문 한 건마다 유지할 btree 가 넷 늘어난다.
  /// 그래도 두는 이유는, 이 넷이 운영진이 하루에도 몇 번씩 여는 화면과 매일 도는
  /// 배치가 쓰는 축이고, 주문 쓰기는 사람이 결제를 누르는 속도로만 일어나기
  /// 때문이다.
  ///
  /// 축이 또 옮겨 가면 `apps/web/test/order-index.test.ts` 가 잡는다.
  @@index([paidAt])
  @@index([status, canceledAt])
  @@index([status, confirmedAt])
  @@index([status, deliveredAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 재고 복원·재구매에 쓴다. 상품이 삭제돼도 주문 내역은 남아야 하므로
  /// onDelete를 걸지 않고 참조만 유지한다.
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // ── 주문 시점 스냅샷
  /// 어느 가맹점의 상품이었는지. 정산과 가맹점 주문 조회의 기준이 된다.
  /// 한 주문에 여러 가맹점 상품이 섞일 수 있어 Order가 아니라 줄 단위로 둔다.
  merchantId  String?
  productName String
  brandName   String
  optionLabel String
  imageUrl    String?
  /// 주문 시점의 정가
  listPrice   Int
  /// 주문 시점의 실제 판매 단가. 표시 할인율은 이 둘에서 계산되므로 따로 두지 않는다.
  unitPrice   Int
  quantity    Int
  /// unitPrice * quantity
  subtotal    Int

  /// 부분 취소·부분 반품을 지원하려면 줄 단위 상태가 필요하다.
  status OrderStatus @default(PENDING)

  /// 이 줄에 붙은 쿠폰 할인·포인트 사용·구매확정 적립의 몫. 주문을 만들 때 core 가 나눠 박는다.
  ///
  /// 줄 하나를 취소할 때 그 줄 몫의 할인은 돌려줄 돈에서 빠져야 한다. 취소하는 날 나누면
  /// **어느 줄이 쿠폰 대상이었는지 알 수 없다** — 상품의 브랜드·분류는 그 사이 바뀐다.
  /// 옛 주문은 null 이고, 그때는 전 줄을 판매가 비율로 나눈다(core 의 sharesOf).
  couponShare Int?
  pointsShare Int?
  rewardShare Int?

  /// 이 줄의 돈이 되돌아간 시각. 가맹점 매출·정산이 줄 단위로 환불을 세는 축이다.
  ///
  /// 주문의 `canceledAt` 만으로는 부분 취소를 못 센다 — 주문은 결제완료인 채로 남고
  /// 줄 하나만 돈이 나갔다.
  canceledAt DateTime?

  /// 구매확정 **뒤에** 돈이 돌아갔는가(확정 뒤 반품).
  ///
  /// 정산은 구매확정된 달에 판매로 싣고, 확정 뒤 돌아간 돈은 돌아간 달에 뺀다. 확정 **전에**
  /// 돌아간 줄(출고 전 일부 취소)은 판 적이 없으므로 싣지도 빼지도 않는다. 둘을 `canceledAt`
  /// 만으로 가르면 한 줄만 반품한 구매확정 주문의 줄이 **지난달 판매에서 소리 없이 빠지거나**,
  /// 이미 지급한 달이면 차감이 영영 안 된다.
  refundedAfterConfirm Boolean @default(false)

  review Review?

  @@index([orderId])
  @@index([variantId])
  @@index([merchantId, status])
  @@index([merchantId, canceledAt])
  @@map("order_items")
}

/// 돈이 되돌아간 사건 하나. 전액 취소·부분 취소·반품 환불이 모두 한 줄씩 남긴다.
///
/// **주문 상태로는 환불을 셀 수 없게 됐다.** 부분 취소한 주문은 결제완료인 채로 남는데
/// 돈은 일부 나갔다. 매출은 "환불 상태인 주문의 결제액" 이 아니라 이 표의 합으로 뺀다.
///
/// 옛 환불(전액)은 마이그레이션이 주문에서 옮겨 적었다.
model OrderRefund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 결제 수단으로 돌려준 돈
  amount           Int
  /// 포인트로 돌려준 몫
  points           Int      @default(0)
  /// 이 취소로 뗀 배송비. 마지막에 전부 취소하면 음수로 돌려준다
  shippingDeducted Int      @default(0)
  /// 되돌린 줄. 전액 취소면 그때 남아 있던 줄 전부
  itemIds          String[]

  /// PARTIAL_CANCEL · CANCEL · REFUND
  kind    String
  reason  String
  /// 운영진 id 이거나 손님 자신, 배치면 "system"
  actorId String

  /// PG 에 보낸 멱등 키. 같은 취소가 두 번 기록되지 않게 한다
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("order_refunds")
}

model OrderStatusLog {
  id      String       @id @default(cuid())
  orderId String
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from    OrderStatus?
  to      OrderStatus
  /// 누가 바꿨는지. 어드민 계정 id이거나 "system"(웹훅·배치).
  actor   String
  note    String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_logs")
}

// ─────────────────────────────────────────── 결제

enum PaymentMethod {
  CARD
  TRANSFER
  VIRTUAL_ACCOUNT
  EASY_PAY
}

/// 토스페이먼츠 결제 상태를 그대로 따른다. PG 상태를 우리 말로 번역하면
/// 웹훅을 대조할 때 매번 매핑 표를 봐야 한다.
enum PaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
  FAILED
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(READY)
  amount Int

  /// PG가 발급한 키. 취소·조회에 쓴다.
  pgProvider     String    @default("toss")
  pgPaymentKey   String?   @unique
  pgApprovalNo   String?
  /// 가상계좌 정보
  virtualAccount String?
  virtualBank    String?
  virtualDueDate DateTime?

  /// 환불 누계. 부분 취소가 여러 번 일어날 수 있다.
  refundedAmount Int @default(0)

  /// PG 응답 원문. 대사(reconciliation)와 장애 분석에 필요하다.
  rawResponse Json?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  canceledAt  DateTime?

  @@index([status, requestedAt])
  @@map("payments")
}

// ─────────────────────────────────────────── 배송

model Shipment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier        String? // "CJ대한통운"
  trackingNumber String?

  shippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingNumber])
  @@map("shipments")
}

// ─────────────────────────────────────────── 쿠폰 · 포인트

enum CouponKind {
  AMOUNT
  PERCENT
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  name String
  kind CouponKind

  /// AMOUNT면 할인액, PERCENT면 사용하지 않는다.
  value        Int  @default(0)
  /// PERCENT일 때 할인율. AMOUNT면 0.
  percent      Int  @default(0)
  /// PERCENT 쿠폰의 할인 상한. null이면 상한 없음.
  maxDiscount  Int?
  minimumOrder Int  @default(0)

  /// 발급 총량. null이면 무제한.
  issueLimit  Int?
  issuedCount Int  @default(0)

  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  issued  UserCoupon[]
  targets CouponTarget[]

  createdAt DateTime @default(now())

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

/// 쿠폰이 붙는 대상.
///
/// 행이 하나도 없으면 장바구니 전체가 대상이다. 있으면 그 목록에 해당하는
/// 줄에만 붙고, **최소 주문 금액도 그 줄들의 합계로 잰다** — 전체를 기준으로
/// 삼으면 대상 아닌 상품으로 기준을 채울 수 있다.
model CouponTarget {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  /// PRODUCT | BRAND | CATEGORY
  targetType String
  targetId   String

  @@unique([couponId, targetType, targetId])
  @@index([couponId])
  @@map("coupon_targets")
}

model UserCoupon {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  usedAt         DateTime?
  expiresAt      DateTime
  /// 곧 사라진다고 알린 때. 한 번만 알린다(core expiry-notice)
  expiryNoticeAt DateTime?
  orders         Order[]

  issuedAt DateTime @default(now())

  /// 같은 쿠폰을 한 사람이 두 번 받지 않는다.
  @@unique([userId, couponId])
  @@index([userId, usedAt])
  /// 곧 사라질 쿠폰을 매일 찾는다
  @@index([expiresAt, usedAt])
  @@map("user_coupons")
}

/// 포인트는 잔액만 두면 왜 그렇게 됐는지 설명할 수 없다.
/// 증감을 원장으로 남기고 User.pointBalance 는 그 합계 캐시로 둔다.
enum PointReason {
  EARN_PURCHASE
  USE_PURCHASE
  EARN_REVIEW
  EARN_SIGNUP
  CANCEL_REFUND
  EXPIRE
  ADMIN_ADJUST
}

model PointTransaction {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 적립은 양수, 사용은 음수. 부호로 방향을 표현해 합계가 곧 잔액이 된다.
  amount Int
  reason PointReason
  note   String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// 적립 포인트의 소멸 예정일. 사용/소멸 건은 null.
  expiresAt      DateTime?
  /// 이 적립이 곧 사라진다고 알린 때. 한 번만 알린다(core expiry-notice)
  expiryNoticeAt DateTime?

  /// 운영진이 손으로 지급·차감할 때 화면이 보낸 열쇠. 같은 열쇠로 두 번 오면 두 번째는 원장에 못 들어간다 —
  /// 지급을 두 번 눌러도 한 번만 나간다. 누가 했는지는 감사 로그가 갖는다.
  adjustKey String? @unique

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("point_transactions")
}

// ─────────────────────────────────────────── 리뷰 · 찜 · 재입고

model Review {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 구매한 사람만 쓸 수 있다. 주문 항목 하나당 리뷰 하나.
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  rating  Int // 1~5
  content String
  /// "정사이즈" / "큼" / "작음" — 상세 화면의 사이즈 분포에 쓴다.
  sizeFit String?
  /// 리뷰어 체형. 사이즈 판단에 실제로 도움이 되는 정보다.
  height  Int?
  weight  Int?

  /// 첨부 사진. 예전에는 주소 배열과 키 배열 **둘**로 들고 있었다.
  ///
  /// 두 배열이 같은 순서라는 약속에 기대는 구조라, 한쪽만 손대면 사진과
  /// 지울 대상이 뒤섞인다. 사진마다 딸린 값(자리표시 그림)을 붙이려니
  /// 세 번째 배열이 필요해져서 그때 표로 옮겼다.
  images ReviewImage[]

  /// 도움이 됐다고 누른 사람 수.
  ///
  /// 표를 세어 두지 않고 매번 집계하면 **정렬을 DB 에 맡길 수 없다** —
  /// 열 건을 보여 주려고 전부 읽어 와 세게 된다. 상품이 별점 합계를 들고
  /// 있는 것과 같은 이유다. 대신 표가 오갈 때마다 같은 트랜잭션에서 고친다.
  helpfulCount Int @default(0)

  /// 판매자 답글. **원문 옆에 말을 더할 뿐** 원문은 건드리지 않는다. 고칠 수 있고 지울 수 있다.
  reply         String?
  /// 처음 답한 시각 — 알림은 이때 한 번만 간다
  repliedAt     DateTime?
  /// 고친 시각. 고쳐졌다는 사실을 화면에 적는다 — 조용히 바뀐 답은 읽은 사람이 무엇을 봤는지 모르게 한다
  replyEditedAt DateTime?
  /// 답한 사람(가맹점 담당자 또는 운영진). 누가 무엇을 썼는지는 감사 로그에도 남는다
  repliedById   String?

  reports  ReviewReport[]
  helpfuls ReviewHelpful[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId, createdAt])
  /// 도움순 정렬
  @@index([productId, helpfulCount])
  @@index([userId])
  @@map("reviews")
}

/// 도움이 됐다고 누른 기록.
///
/// **한 사람이 한 번만** 누를 수 있어야 하는데, 그것을 세는 쪽에서 막으면
/// 두 번 누른 요청이 겹칠 때 새어 나간다. 복합 기본키로 DB 가 막게 한다.
model ReviewHelpful {
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([reviewId, userId])
  /// 내가 누른 것들을 한 번에 묻는다
  @@index([userId])
  @@map("review_helpfuls")
}

enum ReportReason {
  SPAM
  ABUSE
  IRRELEVANT
  PRIVACY
  OTHER
}

/// 리뷰 신고.
///
/// 신고는 **운영진이 먼저 볼 것을 고르는 신호**일 뿐이다. 쌓인다고 글이
/// 자동으로 내려가지는 않는다 — 그렇게 두면 계정 몇 개로 정당한 혹평을
/// 지울 수 있다(core 의 AUTO_HIDE_ON_REPORTS).
/**
 * 리뷰에 붙은 사진 한 장.
 * ProductImage 와 같은 모양이다 — 주소, 지울 때 쓸 저장소 키, 사진이
 * 도착하기 전 깔 자리표시, 순서. 리뷰가 지워지면 함께 지운다.
 */
model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  url         String
  /// 공개 주소가 바뀌어도 지울 대상은 그대로여야 한다. 주소에서 키를
  /// 되짚는 방식은 그때 무너진다.
  storageKey  String
  /// 사진이 도착하기 전 그 자리에 깔 아주 작은 같은 사진(webp 데이터 URI).
  blurDataUrl String?
  sortOrder   Int     @default(0)

  @@index([reviewId])
  @@map("review_images")
}

model ReviewReport {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// 신고한 사람. 탈퇴하면 신고도 함께 사라진다 — 남겨 둘 근거가 없다.
  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason ReportReason
  /// 사유가 OTHER 일 때 주로 쓴다. 없어도 된다.
  detail String?

  /// 처리 시각. null 이면 아직 대기줄에 있다.
  resolvedAt   DateTime?
  /// 처리한 운영자. 계정이 사라져도 처리 기록은 남긴다.
  resolvedById String?
  resolvedBy   User?     @relation("judge", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// 'kept'(문제없음) 또는 'removed'(글을 내림)
  resolution   String?

  createdAt DateTime @default(now())

  /// 한 사람이 같은 리뷰를 여러 번 신고할 수 없다. 없으면 건수가 곧
  /// 열의 개수가 되어 신고 수를 마음대로 부풀릴 수 있다.
  @@unique([reviewId, reporterId])
  /// 대기줄 조회. 처리 안 된 것을 오래된 순으로 꺼낸다.
  @@index([resolvedAt, createdAt])
  @@map("review_reports")
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

/// 반품·교환 신청.
///
/// 주문당 여러 번 남을 수 있다(반려 후 재신청). **가장 최근 것이 현재 신청**이고
/// 지난 것은 이력으로 남긴다 — 왜 반려됐는지 지워 버리면 같은 일이 반복된다.
model ReturnRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// RETURN(반품) | EXCHANGE(교환)
  type   String
  /// CHANGED_MIND | DEFECT | WRONG_ITEM | DAMAGED
  reason String
  /// 고객이 직접 적은 설명
  detail String?

  /// 반품할 줄. **비어 있으면 그때 남아 있던 줄 전부** — 줄을 고르게 되기 전의 신청이 그렇다.
  ///
  /// 코트와 니트를 사서 니트만 작으면 니트만 돌려보내는 것이 보통이다. 주문째 받으면 손님은
  /// 코트까지 돌려보내고 다시 사거나, 반품을 포기한다.
  itemIds String[] @default([])

  /// 반송비를 누가 내는가. CUSTOMER | SELLER
  /// **요청으로 받지 않고 서버가 사유에서 정한다** — 받아 쓰면 누구나
  /// SELLER 를 보내 반송비를 넘길 수 있다.
  shippingBorneBy String

  /// REQUESTED | APPROVED | REJECTED | COMPLETED
  status       String  @default("REQUESTED")
  /// 반려 사유. 고객에게 그대로 보여 준다.
  rejectReason String?

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  /// 돌려보낸 물건이 도착했다고 확인한 시각과 사람.
  ///
  /// 물건을 받는 곳은 가맹점 창고다. 가맹점이 확인하고, 운영진은 그것을 보고 환불한다 — 운영진이
  /// 물건을 본 적도 없이 "도착했다" 를 누르면 안 오는 물건의 값을 치를 수 있다. 운영진이 직접
  /// 회수 확인 · 환불을 누르면 그때 함께 찍힌다.
  receivedAt DateTime?
  receivedBy String?
  /// 처리한 운영자. 배치나 시스템이면 null
  resolvedBy String?

  /// 교환 — 줄마다 무엇으로 바꾸는지. 반품이면 비어 있다
  exchangeLines ReturnExchangeLine[]

  /// 교환 상품을 다시 보낸 송장. 주문의 첫 송장(Shipment)과 따로 둔다 — 덮어쓰면 처음 보낸 기록이 사라진다
  reshipCarrier        String?
  reshipTrackingNumber String?
  reshippedAt          DateTime?

  @@index([orderId, requestedAt])
  @@index([status, requestedAt])
  @@map("return_requests")
}

/// 교환 한 줄 — 돌려보내는 줄과 대신 받을 옵션.
///
/// **신청할 때 바꿀 옵션의 재고를 잡는다.** 승인·회수를 기다리는 며칠 사이에 그 사이즈가 팔려 나가면 교환해 줄
/// 물건이 없다. 반려하면 되돌리고, 교환이 끝나면 돌아온 옵션의 재고를 늘린다.
///
/// 원래 옵션을 적어 둔다 — 교환이 끝나면 주문 줄은 새 옵션을 가리키고(손님이 가진 물건), 처음에 무엇을 샀는지는 여기 남는다.
/// 주문 내부 메모 — 운영진·가맹점이 주문 곁에 남기는 말. **손님에게는 어디에도 보이지 않는다.**
///
/// 가맹점 메모는 그 가맹점과 운영진이, 운영진 메모는 운영진만 본다(core order-note). 운영진이 남기는 상담 내용에는
/// 손님의 사정이 담기는데, 그 주문에 상품 하나 넣은 가맹점이 읽을 말이 아니다.
///
/// 고치지 않는다 — 남긴 말이 나중에 바뀌면 "그때 무엇을 알고 있었나" 를 되짚을 수 없다. 잘못 남겼으면 쓴 사람이
/// 지우고 다시 쓴다(지운 내용은 감사 로그에 남는다).
model OrderNote {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 쓴 사람. 계정이 지워져도 메모는 남는다
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// 가맹점이 남겼으면 그 가맹점. 운영진이면 비어 있다 — 누가 볼 수 있는지가 이것으로 정해진다
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  body      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model ReturnExchangeLine {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String

  fromVariantId   String
  fromOptionLabel String
  toVariantId     String
  toOptionLabel   String
  quantity        Int

  @@index([returnRequestId])
  @@map("return_exchange_lines")
}

model RestockNotification {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, variantId])
  @@index([variantId, notifiedAt])
  @@map("restock_notifications")
}

// ─────────────────────────────────────────── 이벤트 · 감사

/// 사용자 행동 이벤트.
///
/// 자주 집계하는 축만 컬럼으로 뽑고 나머지는 props(Json)에 둔다.
/// 전부 Json 에 넣으면 집계 쿼리를 못 쓰고, 전부 컬럼으로 빼면 이벤트를
/// 하나 추가할 때마다 마이그레이션이 필요해진다.
model EventLog {
  id   String @id @default(cuid())
  /// packages/core 의 COMMERCE_EVENT 값. enum 으로 두지 않는 이유는
  /// 이벤트를 하나 추가할 때마다 DB 마이그레이션을 돌리고 싶지 않아서다.
  /// 유효성은 수집 API 의 Zod 스키마가 이미 보장한다.
  name String

  /// 브라우저가 찍은 시각. 기기 시계는 틀리거나 조작되므로 순서 복원에만 쓴다.
  occurredAt DateTime
  /// 서버 도착 시각. **집계는 이 값을 기준으로 한다.**
  receivedAt DateTime @default(now())

  sessionId   String
  anonymousId String
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  path     String
  referrer String?

  // ── 집계 축. 이벤트 종류에 따라 채워지는 것이 다르다.
  productId  String?
  variantId  String?
  orderId    String?
  merchantId String?
  /// 금액(원). 서버가 기록하는 purchase·refund 에서만 채워진다.
  value      Int?
  quantity   Int?

  /// mobile | tablet | desktop. 원본 User-Agent 는 저장하지 않는다.
  deviceType String?
  /// 일별 솔트로 해시한 IP. 원본은 저장하지 않고 봇 판별에만 쓴다.
  ipHash     String?

  /// 위 컬럼으로 뽑지 않은 나머지 속성
  props Json @default("{}")

  @@index([name, receivedAt])
  @@index([sessionId, occurredAt])
  @@index([userId, receivedAt])
  @@index([productId, name])
  @@index([receivedAt])
  @@map("event_logs")
}

/// 하루치로 접은 이벤트 수.
///
/// 원본은 보존 기간이 지나면 지우지만 이 행은 남는다. 지표를 보려고 원본을
/// 영원히 들고 있을 수는 없고, 그렇다고 지난 달 매출을 못 보게 할 수도 없다.
model EventDaily {
  id String @id @default(cuid())

  /// KST 기준 하루. UTC 로 자르면 매일 오전 9시간이 앞날 칸에 들어간다.
  day  DateTime @db.Date
  name String

  /// 이벤트 수. **날짜끼리 더해도 된다.**
  events   Int
  /// 그날의 고유 세션 수. **더하면 안 된다** — 이틀에 걸쳐 온 세션이 양쪽에 세어져 있다.
  sessions Int
  /// 그날의 고유 로그인 사용자 수. 세션과 같은 이유로 더하면 안 된다.
  users    Int
  /// 금액 합계(원). purchase·refund 에만 채워진다. 더해도 된다.
  value    Int @default(0)
  /// 수량 합계. 더해도 된다.
  quantity Int @default(0)

  @@unique([day, name])
  @@index([day])
  @@map("event_daily")
}

/// 하루치 퍼널.
///
/// 이름별 세션 수(EventDaily.sessions)만으로는 strict 퍼널을 되살릴 수 없다.
/// "앞 단계를 모두 거친 세션" 은 세션 단위로 교집합을 내야 나오는 값이라
/// 접을 때 함께 계산해 둔다.
model FunnelDaily {
  id String @id @default(cuid())

  day      DateTime @db.Date
  step     String
  /// 이 단계까지 앞 단계를 **모두** 거친 세션 수
  sessions Int

  @@unique([day, step])
  @@index([day])
  @@map("funnel_daily")
}

/// 어느 날까지 접었는지에 대한 기록.
///
/// 원본 삭제가 이 표를 본다. 접힌 날만 지우므로, 롤업이 고장 나면 삭제도
/// 함께 멈춘다. 테이블이 커지는 것은 눈에 보이고 데이터가 사라지는 것은
/// 보이지 않으니, 보이는 쪽으로 실패하게 둔다.
model EventRollup {
  /// KST 기준 하루
  day DateTime @id @db.Date

  /// 접을 당시의 원본 행 수. 나중에 "이 날은 왜 이렇게 적지" 를 볼 때 쓴다.
  rawEvents   Int
  completedAt DateTime @default(now())

  @@map("event_rollups")
}

/// 운영진·가맹점의 쓰기 동작 기록.
///
/// 권한을 나눠 놓고 누가 무엇을 했는지 남기지 않으면 절반만 한 것이다.
/// 환불·권한부여처럼 되돌릴 수 없고 돈이 걸린 동작이 대상이다.
model AdminAuditLog {
  id String @id @default(cuid())

  /// 사람이 한 동작이면 채워진다. **배치는 사용자가 아니므로 비어 있다.**
  /// 필수로 두면 자동 실행이 감사 로그를 아예 못 남긴다 —
  /// 정산 확정처럼 돈이 걸린 배치가 흔적 없이 도는 것이 가장 나쁘다.
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  /// actorId 가 없을 때 무엇이 했는지. 'system:cron' 같은 이름.
  actorLabel String?

  /// **그 시점의** 역할과 소속. 나중에 역할이 바뀌어도 "그때 무슨 권한으로
  /// 했는지"가 남아야 하므로 조인이 아니라 스냅샷으로 박는다.
  actorRole  UserRole
  merchantId String?

  /// 'order.refund', 'user.assignRole' 처럼 <대상>.<동작> 형태
  action     String
  targetType String
  targetId   String

  /// 변경 전후. 민감 필드는 호출부에서 제외하고 넘긴다.
  before Json?
  after  Json?

  ipHash String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────── 인증 (Better Auth)
//
// 아래 세 모델의 필드 이름과 타입은 Better Auth 가 요구하는 그대로다.
// 임의로 바꾸면 어댑터가 찾지 못한다. User 는 우리 모델을 그대로 쓰되
// Better Auth 가 요구하는 image 만 추가했다.

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  /// 세션 탈취 탐지에 쓴다. 이벤트 로그와 달리 여기서는 원본을 보관한다 —
  /// 수상한 로그인을 사용자에게 보여 주려면 실제 값이 필요하다.
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id         String @id @default(cuid())
  issuer     String
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 소셜 로그인 토큰. 이메일 가입이면 password 만 채워진다.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Better Auth 가 해시해서 넣는다. 평문이 들어올 일은 없다.
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// 상품 문의.
///
/// 리뷰는 산 사람만 쓸 수 있어서, 사기 전에 물어볼 자리가 따로 필요하다.
/// 답변은 한 문의에 하나뿐이라 별도 모델로 두지 않고 여기 담는다 —
/// 주고받는 대화가 필요한 수준이면 그때 나눈다.
/// 알림의 종류.
///
/// **문구를 저장하지 않는다.** 알림은 나중에 읽는 글이고, 그 사이에 사용자가
/// 언어를 바꿀 수 있다 — 만들 때의 말로 굳혀 두면 그때 어긋난다. 무슨 일이
/// 있었는지(kind)와 끼울 값(params)만 남기고, 문장은 화면이 만든다.
enum NotificationKind {
  ORDER_SHIPPED
  ORDER_DELIVERED
  INQUIRY_ANSWERED
  RESTOCKED
  /// 운영진이 지급한 쿠폰. 받은 줄 모르면 쿠폰은 없는 것과 같다.
  COUPON_ISSUED
  /// 가맹점 상품의 옵션 재고가 기준 아래로 내려갔다 — 운영 알림함에만 뜬다
  STOCK_LOW
  /// 내 리뷰에 판매자가 답했다
  REVIEW_REPLIED
  /// 교환한 상품을 보냈다
  EXCHANGE_SHIPPED
  /// 주문(의 일부)이 취소됐다
  ORDER_CANCELLED
  /// 반품·교환 신청이 승인됐다
  RETURN_APPROVED
  /// 반품·교환 신청이 반려됐다
  RETURN_REJECTED
  /// 환불이 끝났다
  REFUND_COMPLETED
  /// 운영진이 적립금을 줬다 / 뺐다
  POINTS_GRANTED
  POINTS_DEDUCTED
  /// 이용 정지가 풀렸다
  ACCOUNT_RESTORED
  /// 쿠폰·적립금이 한 주 안에 사라진다
  COUPON_EXPIRING
  POINTS_EXPIRING
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// 문구에 끼울 값. 상품 이름, 주문번호 같은 것.
  params Json?

  /// 눌렀을 때 갈 곳. 우리 경로만 넣는다.
  linkPath String?

  /// 읽은 시각. null 이면 아직 안 읽었다.
  readAt DateTime?

  createdAt DateTime @default(now())

  /// 내 알림 목록
  @@index([userId, createdAt])
  /// 안 읽은 개수 — 모든 화면의 머리에서 센다
  @@index([userId, readAt])
  @@map("notifications")
}

/// 알림 문구 템플릿 — 종류·언어마다 하나.
///
/// **줄이 없으면 사전의 기본 문구를 쓴다.** 운영이 고친 것만 담는다 — 기본 문구까지 다 넣어 두면 사전을 고쳐도
/// 화면이 안 바뀌고, 어느 것이 손댄 문구인지 알 수 없다. 끼울 수 있는 값은 코드가 정한다(@shop/core NOTIFICATION_PARAMS).
///
/// 알림 한 건에는 문장을 저장하지 않으므로, 여기를 고치면 **이미 온 알림도 새 문구로 읽힌다.**
model NotificationTemplate {
  kind   NotificationKind
  /// 'ko' | 'en' | 'ja'
  locale String
  body   String

  /// 마지막으로 고친 운영자. 누가 무엇에서 무엇으로 바꿨는지는 감사 로그에 있다
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([kind, locale])
  @@map("notification_templates")
}

/// 메일 문구 템플릿 — 메일 종류·말마다 한 줄, 칸(제목·머리말·첫 문장)마다 비어 있으면 사전의 기본 문구.
///
/// 종류는 enum 이 아니라 글자로 둔다 — 고칠 수 있는 메일 목록은 코드(@shop/core MAIL_TEMPLATE_KIND)가 정하고, 목록이
/// 줄어도 옛 줄이 마이그레이션을 막지 않는다. 읽을 때 모르는 종류는 버린다.
model MailTemplate {
  kind    String
  locale  String
  subject String?
  heading String?
  lead    String?

  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([kind, locale])
  @@map("mail_templates")
}

/// 고객센터 글의 종류.
///
/// 공지와 FAQ 를 **한 표에 둔다.** 둘 다 "운영진이 쓰는 공개 글" 이고 담는
/// 것이 같다 — 제목, 본문, 공개 여부, 쓴 사람. 다른 것은 보여 주는 방식뿐이다:
/// 공지는 최근 순으로 쌓이고 FAQ 는 주제별로 묶인다. 표를 나누면 목록·작성·
/// 수정·삭제가 두 벌이 되는데, 그것을 나눠서 얻는 것은 쓰지 않는 칸 두 개를
/// 지우는 것뿐이다.
enum SupportPostKind {
  NOTICE
  FAQ
}

/// 무엇에 대한 물음인가. FAQ 분류와 1:1 문의 분류가 같은 목록을 쓴다 —
/// 자주 묻는 것을 모아 둔 것이 FAQ 이므로 갈래가 달라질 이유가 없다.
enum InquiryTopic {
  DELIVERY
  EXCHANGE
  PAYMENT
  ACCOUNT
  PRODUCT
  ETC
}

model SupportPost {
  id   String          @id @default(cuid())
  kind SupportPostKind

  title String

  /// 서식을 뺀 본문.
  ///
  /// **나무(bodyRich)가 있어도 이 칸은 남긴다.** 목록의 요약, 검색,
  /// `<meta description>` 은 서식이 필요 없고 오히려 방해가 된다. 뽑아내는
  /// 규칙은 core 에 하나뿐이라(richTextToPlainText) 목록과 본문이 다른 말을
  /// 하지 않는다. 나무가 없는 옛 글은 이 칸만 갖는다.
  body String

  /// 서식 있는 본문. core 가 정한 어휘로만 이뤄진 나무다.
  ///
  /// **HTML 문자열이 아니다.** 편집기가 만든 HTML 을 그대로 담으면 이 칸이
  /// 공개 화면에서 그대로 실행된다. 어휘는 rich-text.ts 가 정하고 계약이
  /// 강제한다. 서식 없이 쓰인 옛 글은 null 이다.
  bodyRich Json?

  /// FAQ 의 갈래. 공지에는 없다.
  topic InquiryTopic?

  /// 공지 상단 고정. FAQ 는 쓰지 않는다.
  pinned    Boolean @default(false)
  /// FAQ 안에서의 순서. 공지는 날짜로 정렬하므로 쓰지 않는다.
  sortOrder Int     @default(0)

  /// null 이면 아직 내보내지 않은 글이다. 쓰다 만 공지가 새어 나가지 않게
  /// 초안과 게시를 상태가 아니라 시각으로 가른다 — 언제 나갔는지도 남는다.
  publishedAt DateTime?

  /// 쓴 사람. 계정이 사라져도 글은 남긴다.
  authorId String?
  author   User?   @relation("SupportPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// 공지 목록 · FAQ 목록
  @@index([kind, publishedAt])
  @@map("support_posts")
}

model Inquiry {
  id String @id @default(cuid())

  /// 어떤 상품에 대한 물음인가. **없을 수 있다** — 배송이나 환불처럼 상품과
  /// 무관한 물음은 고객센터로 들어온다. 그 문의는 파는 사람이 아니라 운영진의
  /// 몫이라, 상품이 없으면 가맹점 범위에도 걸리지 않는다.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 무엇에 대한 물음인가. 상품 문의에는 없다 — 이미 상품이 그것을 말한다.
  topic InquiryTopic?

  authorId String
  author   User   @relation("InquiryAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  content   String
  /// 비공개 문의. 쓴 사람과 답할 사람만 내용을 본다.
  /// 사이즈를 물으며 체형을, 배송을 물으며 사는 곳을 적는 일이 흔하다.
  isPrivate Boolean @default(false)

  answer       String?
  /// 답한 사람. 계정이 사라져도 답변은 남긴다.
  answeredById String?
  answeredBy   User?     @relation("InquiryAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// 상품 화면의 목록
  @@index([productId, createdAt])
  /// 내가 쓴 문의
  @@index([authorId, createdAt])
  /// 운영진의 미답변 대기줄
  @@index([answeredAt, createdAt])
  @@map("inquiries")
}
