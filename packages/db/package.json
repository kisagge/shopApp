{
  "name": "@shop/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:collections": "tsx src/seed-collections-only.ts",
    "backfill:search": "tsx src/backfill-search-text.ts"
  },
  "dependencies": {
    "@shop/core": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@shop/config": "workspace:*",
    "dotenv": "17.2.3",
    "eslint": "10.9.1",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
