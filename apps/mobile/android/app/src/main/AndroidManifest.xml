<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                앱 링크.

                공유받은 https 주소를 브라우저가 아니라 이 앱이 연다.
                autoVerify 를 켜면 설치할 때 안드로이드가 그 도메인의
                /.well-known/assetlinks.json 을 받아 가 서명 지문을 견주고,
                맞을 때만 "이 앱이 연다" 로 굳힌다 — 아무 앱이나 남의 도메인
                링크를 가로채지 못하게 하는 장치다.

                지문이 안 맞거나 파일이 없으면 조용히 브라우저로 간다.
                호스트는 capacitor.config 의 PRODUCTION_URL 과 같아야 하고,
                apps/web 의 검사가 그것을 지킨다.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="plain-shop-byjang.vercel.app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      WebView 가 망이 바뀐 것을 알아채려면 이것이 있어야 한다.

      **없으면 감지기가 통째로 죽는다.** 비행기 모드로 완전히 끊어 놓고
      재 봤더니 WebView 안에서는 navigator.onLine 이 그대로 true 였고
      online/offline 이벤트가 **한 개도** 오지 않았다. 그러면 오프라인
      화면(www/index.html)이 "연결이 돌아오면 스스로 들어간다" 며 걸어 둔
      online 청취가 영원히 안 울린다 — 사용자가 단추를 눌러야만 한다.
      끊긴 채로 눌렀을 때 흔들어 주는 것도 navigator.onLine === false 를
      보는데, 그 값이 false 가 되는 일이 없으니 그 갈래도 죽어 있다.

      한 번은 더 나쁘게 나왔다. 와이파이에서 LTE 로 넘어간 뒤 셸에서는
      이름이 풀리는데 WebView 만 ERR_NAME_NOT_RESOLVED 를 냈고, 앱을
      다시 띄울 때까지 그대로였다. 망이 바뀐 것을 모르니 옛 경로의 DNS 와
      소켓을 그대로 쓰는 것이다.

      위치도 기기 식별자도 읽지 않는다. 연결 상태만 본다.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
