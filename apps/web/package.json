{
  "name": "@shop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "setup:bucket": "node --env-file=../../.env scripts/setup-bucket.mjs",
    "seed:images": "tsx --env-file=../../.env scripts/seed-images.ts",
    "seed:banners": "tsx --env-file=../../.env scripts/seed-banners.ts",
    "seed:photos": "tsx --env-file=../../.env scripts/fetch-product-photos.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@shop/auth": "workspace:*",
    "@shop/contract": "workspace:*",
    "@shop/core": "workspace:*",
    "@shop/db": "workspace:*",
    "@shop/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4",
    "zustand": "5.0.15",
    "@shop/native": "workspace:*",
    "@shop/mail": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@shop/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
