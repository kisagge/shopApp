{
  "name": "@shop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "setup:bucket": "node --env-file=../../.env scripts/setup-bucket.mjs",
    "seed:images": "tsx --env-file=../../.env scripts/seed-images.ts",
    "seed:banners": "tsx --env-file=../../.env scripts/seed-banners.ts",
    "seed:collections": "tsx --env-file=../../.env scripts/seed-collections.ts",
    "seed:photos": "tsx --env-file=../../.env scripts/fetch-product-photos.ts",
    "backfill:blur": "tsx --env-file=../../.env scripts/backfill-blur.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@shop/auth": "workspace:*",
    "@shop/contract": "workspace:*",
    "@shop/core": "workspace:*",
    "@shop/db": "workspace:*",
    "@shop/i18n": "workspace:*",
    "@shop/mail": "workspace:*",
    "@shop/native": "workspace:*",
    "@shop/ui": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "web-vitals": "^6.2.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@shop/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tiptap/core": "3.32.0",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
